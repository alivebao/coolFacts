{
  "containers": [
    {
      "name": "coolfacts",
      "domain": "",
      "ip": "",
      "mode": "compose",
      "containerId": "776373779c524e182b080197a811afb5f2e739084481393486a9be36d7f3a923"
    }
  ],
  "config": {
    "coolfacts": {
      "containerPort": 80,
      "minNum": 0,
      "maxNum": 5,
      "cpu": 1,
      "mem": 2,
      "policyType": "cpu",
      "policyThreshold": 60,
      "policyDetails": [
        {
          "PolicyType": "cpu",
          "PolicyThreshold": 60
        },
        {
          "PolicyType": "mem",
          "PolicyThreshold": 60
        }
      ],
      "envParams": {
        "MYSQL_USERNAME": "root",
        "MYSQL_PASSWORD": "root",
        "MYSQL_ADDRESS": "host.docker.internal:3306"
      },
      "customLogs": "stdout",
      "initialDelaySeconds": 2,
      "dataBaseName": "flask_demo",
      "executeSQLs": [
        "CREATE DATABASE IF NOT EXISTS flask_demo;",
        "USE flask_demo;",
        "CREATE TABLE IF NOT EXISTS `Counters` (`id` int(11) NOT NULL AUTO_INCREMENT, `count` int(11) NOT NULL DEFAULT 1, `createdAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, `updatedAt` timestamp NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (`id`)) ENGINE = InnoDB DEFAULT CHARSET = utf8;"
      ]
    }
  }
}